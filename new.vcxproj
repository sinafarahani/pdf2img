    <ClCompile Include="src\cli.cpp" />
    <ClCompile Include="src\common.cpp" />
    <ClCompile Include="src\config.cpp" />
    <ClCompile Include="src\fsutil.cpp" />
    <ClCompile Include="src\ipc.cpp" />
    <ClCompile Include="src\log.cpp" />
