#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PDF2IMG_VERSION_RC
 PRODUCTVERSION PDF2IMG_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "PDF To Image Converter (PDFium-based rewrite)"
            VALUE "FileDescription", "PDF To Image Converter"
            VALUE "FileVersion", PDF2IMG_VERSION
            VALUE "InternalName", "pdf2img"
            VALUE "OriginalFilename", "pdf2img.exe"
            VALUE "ProductName", "pdf2img"
            VALUE "ProductVersion", PDF2IMG_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
